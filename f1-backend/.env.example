# ─── Uygulama ───────────────────────────────────────────
APP_NAME=F1 Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-openssl-rand-hex-32

# ─── Veritabanı ─────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=f1platform
POSTGRES_USER=f1user
POSTGRES_PASSWORD=f1pass
DATABASE_URL=postgresql+asyncpg://f1user:f1pass@db:5432/f1platform

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Auth ────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Dış API'ler ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENF1_BASE_URL=https://api.openf1.org/v1
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# ─── CORS ───────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Push Bildirimleri (opsiyonel) ──────────────────────────────────────────
# pip install py-vapid && vapid --gen --applicationServerKey
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@f1platform.com
